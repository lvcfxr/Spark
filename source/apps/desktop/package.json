{
  "name": "spark",
  "version": "0.16.0",
  "description": "Spark \u2014 \u043a\u0430\u0440\u0442\u043e\u0447\u043a\u0438 \u0441 \u0438\u043d\u0442\u0435\u0440\u0432\u0430\u043b\u044c\u043d\u044b\u043c\u0438 \u043f\u043e\u0432\u0442\u043e\u0440\u0435\u043d\u0438\u044f\u043c\u0438",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && electron .",
    "test": "node electron/storage.test.cjs",
    "dist:win": "node build.mjs && electron-builder --win dir --x64 && node scripts/set-exe-icon.cjs release/win-unpacked/Recall.exe brand/icon.ico && electron-builder --win portable --x64 --prepackaged release/win-unpacked",
    "dist:mac": "node build.mjs && electron-builder --mac"
  },
  "keywords": [],
  "author": "Spark",
  "license": "ISC",
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "resedit": "^3.1.0",
    "typescript": "^7.0.2"
  },
  "productName": "Spark",
  "private": true,
  "build": {
    "appId": "app.spark.desktop",
    "productName": "Spark",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "!electron/*.test.cjs",
      "dist/index.html",
      "dist/config.js",
      "build/icon.png"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false,
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Spark-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Spark-${version}-portable.exe"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png"
    }
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "fzstd": "^0.1.1",
    "sql.js": "^1.15.2"
  }
}